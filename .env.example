# CampusFind Environment Configuration

PROJECT_NAME=CampusFind
API_V1_STR=/api/v1

# Security
SECRET_KEY=campusfind-super-secret-key-change-in-production-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# College Email Domain (Comma-separated for multiple domains)
COLLEGE_EMAIL_DOMAIN=example.edu

# Database (PostgreSQL for Docker/Production, SQLite for local dev)
# DATABASE_URL=postgresql://campususer:campuspassword@localhost:5432/campusfind
DATABASE_URL=sqlite:///./campusfind.db

# Matching Engine Configuration
MATCH_WEIGHT_CATEGORY=0.25
MATCH_WEIGHT_LOCATION=0.20
MATCH_WEIGHT_DATE=0.20
MATCH_WEIGHT_KEYWORDS=0.15
MATCH_WEIGHT_BRAND=0.10
MATCH_WEIGHT_COLOR=0.05
MATCH_WEIGHT_DESCRIPTION=0.05
MATCH_MIN_THRESHOLD=0.40

# Handover Verification
HANDOVER_TOKEN_EXPIRE_MINUTES=30
